{
  "name": "vauthunters-rewards",
  "version": "1.0.0",
  "description": "Vault Hunters rewards lookup tool",
  "main": "public/pages/index.html",
  "type": "module",
  "engines": {
    "node": ">=20 <22"
  },
  "scripts": {
    "start": "npm run build:local && npx --yes wrangler@4.131.0 pages dev dist --compatibility-date=2024-12-10",
    "dev": "npm run build:local && npx --yes wrangler@4.131.0 pages dev dist --compatibility-date=2024-12-10",
    "build": "node build.js",
    "build:dev": "node build.js --dev --keep-chunks",
    "build:watch": "node build.js --dev --watch --keep-chunks",
    "build:prod": "node build.js",
    "build:local": "node build.js --keep-chunks",
    "deploy": "npm run build:prod && npx --yes wrangler@4.83.0 pages deploy dist",
    "db:migrate:local": "npx --yes wrangler@4.83.0 d1 migrations apply vauthunters_rewards --local",
    "db:migrate:remote": "npx --yes wrangler@4.83.0 d1 migrations apply vauthunters_rewards --remote",
    "snapshots:deploy": "npx --yes wrangler@4.131.0 deploy --config workers/leaderboard-snapshots/wrangler.jsonc",
    "snapshots:dev": "npx --yes wrangler@4.131.0 dev --config workers/leaderboard-snapshots/wrangler.jsonc --test-scheduled",
    "test": "node --import ./tests/register-json-loader.mjs --test tests/*.test.js",
    "test:collector": "npm --prefix scripts/companion-collector test",
    "test:all": "npm test && npm run test:collector",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "vault-hunters",
    "minecraft",
    "rewards"
  ],
  "author": "massuus",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/massuus/Vauthunters-Rewards.git"
  },
  "bugs": {
    "url": "https://github.com/massuus/Vauthunters-Rewards/issues"
  },
  "homepage": "https://vh-rewards.massuus.com",
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "autoprefixer": "^10.4.22",
    "cssnano": "^7.1.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.14.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "swagger-ui-dist": "5.34.1"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
