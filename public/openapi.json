{
  "openapi": "3.0.3",
  "info": {
    "title": "Vault Hunters Rewards API",
    "version": "1.0.0",
    "description": "Public lookup endpoints implemented by this app. Partial API documentation: authentication, administration, collector ingestion and mining workflows are outside this spec. Flexible response schemas reflect evolving upstream data."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/profile": {
      "get": {
        "summary": "Look up player rewards and companion stats",
        "description": "Supply at least one of username or twitchUsername. Requests are rate limited.",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": false,
            "description": "Minecraft username (3-16 letters, digits or underscores).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "twitchUsername",
            "in": "query",
            "required": false,
            "description": "Twitch username (1-25 letters, digits or underscores).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed; response may include an error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/sets": {
      "get": {
        "summary": "List reward sets",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request failed; response may include an error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/server": {
      "get": {
        "summary": "List official servers and players",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request failed; response may include an error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/developers": {
      "get": {
        "summary": "List developers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request failed; response may include an error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/badges": {
      "get": {
        "summary": "Get the companion badge catalog",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed; response may include an error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/players": {
      "get": {
        "summary": "Search known players",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search text; 2-32 letters, digits, underscores or spaces.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed; response may include an error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/leaderboard": {
      "get": {
        "summary": "Get a leaderboard page",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "description": "Ranking metric.",
            "schema": {
              "type": "string",
              "enum": ["setsUnlocked", "seasonLevel", "vaultsJoined"],
              "default": "setsUnlocked"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, capped at 50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Pagination offset.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "streamer",
            "in": "query",
            "required": false,
            "description": "Streamer filter for companion metrics.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "player",
            "in": "query",
            "required": false,
            "description": "Player to locate in the ranking.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Request failed; response may include an error message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/streamer-stats": {
      "get": {
        "summary": "Get streamer statistics",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
